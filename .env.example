# GEMINI_API_KEY: Wajib diisi untuk memanggil Google Gemini API dari backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini yang digunakan di backend (default: gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: URL aplikasi saat di-hosting (otomatis diisi oleh platform atau Vercel).
APP_URL="http://localhost:3000"

# Google OAuth 2.0 (Opsional - untuk fitur Hubungkan Google Account resmi)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""

